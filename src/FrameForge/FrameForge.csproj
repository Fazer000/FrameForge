<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrameForge</AssemblyName>
    <ApplicationIcon>Assets/FrameForge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/FrameForge.ico" />
    <ProjectReference Include="../FrameForge.Core/FrameForge.Core.csproj" />
  </ItemGroup>
</Project>
