<!-- Поля параметров обработки. -->
<UserControl x:Class="FrameForge.ProcessingSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Алгоритм" Margin="0,0,0,6"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Name"/>
    <TextBlock Text="Качество кодирования H.264" Margin="0,14,0,6"/>
    <ComboBox x:Name="EncodingBox" SelectedValuePath="Tag" ToolTip="CRF определяет качество итогового видео H.264. Меньше CRF — выше качество и обычно больше размер файла."/>
    <TextBlock Text="Разрешение" Margin="0,14,0,6"/><ComboBox x:Name="ResolutionBox" SelectionChanged="ResolutionChanged"><ComboBoxItem Content="1080p · FHD" Tag="1920,1080"/><ComboBoxItem Content="1440p · QHD" Tag="2560,1440"/><ComboBoxItem Content="2160p · 4K" Tag="3840,2160"/><ComboBoxItem Content="Настраиваемое" Tag="custom"/></ComboBox>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,12"><TextBox x:Name="TargetWidthBox" Text="1920" Width="100"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="TargetHeightBox" Text="1080" Width="100"/></StackPanel>
    <CheckBox x:Name="KeepTemporaryBox" Content="Сохранять временные файлы" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" ToolTip="При уменьшении результата используется промежуточное видео без потерь. Для длинных файлов нужно много свободного места."/>
    <CheckBox x:Name="FullVideoBox" Content="Обрабатывать видео целиком" IsChecked="True" Foreground="{StaticResource TextBrush}" Checked="RangeChanged" Unchecked="RangeChanged"/>
    <StackPanel x:Name="RangePanel" Orientation="Horizontal" Margin="0,8,0,12"><StackPanel><TextBlock Text="Начало, сек."/><TextBox x:Name="StartSeconds" Text="60" Width="120"/></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Text="Длина, сек."/><TextBox x:Name="DurationSeconds" Text="10" Width="120"/></StackPanel></StackPanel>
  </StackPanel>
</UserControl>
