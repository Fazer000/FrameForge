<!-- Разметка главного окна. -->
<Window x:Class="FrameForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Frame Forge" Icon="/Assets/FrameForge.ico" Width="1240" Height="900" MinWidth="1050" MinHeight="760" Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
 <Grid Margin="24" TextElement.Foreground="{StaticResource TextBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="FRAME FORGE" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
  </StackPanel>
  <Grid x:Name="WorkspacePanel" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" Margin="0,0,10,0">
    <TextBlock Text="Параметры новых заданий" FontSize="18" Margin="0,0,0,14"/>
    <TextBlock Text="Алгоритм" Margin="0,0,0,6"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Name"/>
    <TextBlock Text="Качество кодирования H.264" Margin="0,14,0,6"/>
    <ComboBox x:Name="EncodingBox" ToolTip="CRF определяет качество итогового видео H.264. Меньше CRF — выше качество и обычно больше размер файла.">
     <ComboBoxItem Tag="22" Content="Компактное (CRF 22)"/>
     <ComboBoxItem Tag="20" Content="Сбалансированное (CRF 20)"/>
     <ComboBoxItem Tag="16" Content="Высокое (CRF 16)"/>
    </ComboBox>
    <TextBlock Text="Разрешение" Margin="0,14,0,6"/><ComboBox x:Name="ResolutionBox" SelectionChanged="ResolutionChanged"><ComboBoxItem Content="1080p · FHD" Tag="1920,1080"/><ComboBoxItem Content="1440p · QHD" Tag="2560,1440"/><ComboBoxItem Content="2160p · 4K" Tag="3840,2160"/><ComboBoxItem Content="Настраиваемое" Tag="custom"/></ComboBox>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,12"><TextBox x:Name="TargetWidthBox" Text="1920" Width="100"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="TargetHeightBox" Text="1080" Width="100"/></StackPanel>
    <CheckBox x:Name="KeepTemporaryBox" Content="Сохранять временные файлы" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" ToolTip="При уменьшении результата используется промежуточное видео без потерь. Для длинных файлов нужно много свободного места."/>
    <CheckBox x:Name="FullVideoBox" Content="Обрабатывать видео целиком" IsChecked="True" Foreground="{StaticResource TextBrush}" Checked="RangeChanged" Unchecked="RangeChanged"/>
    <StackPanel x:Name="RangePanel" Orientation="Horizontal" Margin="0,8,0,12"><StackPanel><TextBlock Text="Начало, сек."/><TextBox x:Name="StartSeconds" Text="60" Width="120"/></StackPanel><StackPanel Margin="10,0,0,0"><TextBlock Text="Длина, сек."/><TextBox x:Name="DurationSeconds" Text="10" Width="120"/></StackPanel></StackPanel>
    <TextBlock Text="Папка результатов обработки" Margin="0,0,0,6"/><TextBox x:Name="OutputPath" IsReadOnly="True"/><Button Content="Выбрать папку…" Click="ChooseOutput" Margin="0,6,0,14"/>
    <Expander Header="Библиотека AnimeLib" Foreground="{StaticResource AccentBrush}"><StackPanel Margin="0,8,0,0"><TextBox x:Name="LibraryPath"/><Button Content="Выбрать библиотеку…" Click="ChooseLibrary" Margin="0,6,0,6"/><TextBlock Text="После проверки улучшенный файл заменяет серию; временный оригинал удаляется. Закройте AnimeLib перед заменой." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><Button Content="Добавить видео…" Click="AddFiles"/><Button Content="Из AnimeLib…" Click="AddLibrary"/></WrapPanel>
    <DataGrid x:Name="JobsGrid" Grid.Row="1" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" CanUserAddRows="False" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource AlternateSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="None" SelectionChanged="JobSelected"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Target}" Width="100"/><DataGridTextColumn Header="Диапазон" Binding="{Binding Range}" Width="100"/><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="140"/><DataGridTextColumn Header="%" Binding="{Binding Progress, StringFormat=F0}" Width="45"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="0,10,0,10"><Button Content="Повторить" Click="Retry"/><Button Content="Убрать" Click="Remove" ToolTip="Убирает задания из очереди. Файлы остаются на диске."/><Button Content="Результат" Click="OpenResults"/></WrapPanel>
    <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12"/>
    <StackPanel Grid.Row="4"><TextBlock x:Name="StatusText" Text="Готов к работе" Margin="0,0,0,8"/>
     <TextBlock x:Name="QueueMetricsText" Text="Выполнено: 0 %   ·   Прошло: 00:00:00   ·   Осталось: —" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" Content="Запустить очередь" Click="Run"/><Button x:Name="CancelButton" Content="Остановить очередь" IsEnabled="False" Click="Cancel"/></StackPanel></StackPanel>
   </Grid>
  </Grid>
  <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
   <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22"
           HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
     <TextBlock Text="Идет загрузка файлов. Подождите..." AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar IsIndeterminate="True" Height="5" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
