<Window x:Class="FrameForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Frame Forge · Прототип" Width="1060" Height="850" MinWidth="850" MinHeight="700" Background="#101827" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
 <Grid Margin="28" TextElement.Foreground="#E4E9F3">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22">
   <TextBlock Text="FRAME FORGE" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock Text="Лаборатория улучшения видео · RTX 5080 / Vulkan" Foreground="#97ABC8" Margin="0,5,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" x:Name="SettingsPanel">
   <TextBlock Text="Исходное видео" Margin="0,0,0,6"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Открыть видео…" Click="ChooseInput" Margin="10,0,0,0"/><TextBox x:Name="InputPath" IsReadOnly="True"/></DockPanel>
   <TextBlock x:Name="VideoInfo" Text="Добавьте файл. Исходники не перезаписываются." Foreground="#97ABC8" Margin="0,8,0,16" TextWrapping="Wrap"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Модель" Margin="0,0,0,6"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Name"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Разрешение" Margin="0,0,0,6"/><ComboBox x:Name="ResolutionBox" SelectedIndex="0" SelectionChanged="ResolutionChanged"><ComboBoxItem Content="1080p" Tag="1920,1080"/><ComboBoxItem Content="1440p" Tag="2560,1440"/><ComboBoxItem Content="2160p / 4K" Tag="3840,2160"/><ComboBoxItem Content="Своё" Tag="custom"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Начало, сек." Margin="0,0,0,6"/><TextBox x:Name="StartSeconds" Text="60"/></StackPanel>
    <StackPanel Grid.Column="3"><TextBlock Text="Длина, сек." Margin="0,0,0,6"/><TextBox x:Name="DurationSeconds" Text="10"/></StackPanel>
   </Grid>
   <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Вписать в" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="TargetWidthBox" Text="1920" Width="85" IsEnabled="False"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="TargetHeightBox" Text="1080" Width="85" IsEnabled="False"/><TextBlock Text="пикселей · пропорции сохраняются" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
   <TextBlock Text="Разрешение ограничивает размер файла на выходе. Real-ESRGAN Plus внутри работает в 4×. H.264, CRF 16." Foreground="#97ABC8" Margin="0,9,0,16" TextWrapping="Wrap"/>
   <TextBlock Text="Папка результатов" Margin="0,0,0,6"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Выбрать…" Click="ChooseOutput" Margin="10,0,0,0"/><TextBox x:Name="OutputPath" IsReadOnly="True"/></DockPanel>
   <Expander Header="Инструменты обработки" Foreground="#A8BFE2" Margin="0,16,0,12">
    <StackPanel Margin="0,10,0,0">
     <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Video2X…" Click="ChooseVideo2X" Margin="10,0,0,0"/><TextBox x:Name="Video2XPath"/></DockPanel>
     <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="FFmpeg…" Click="ChooseFFmpeg" Margin="10,0,0,0"/><TextBox x:Name="FFmpegPath"/></DockPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="ffprobe…" Click="ChooseFFprobe" Margin="10,0,0,0"/><TextBox x:Name="FFprobePath"/></DockPanel>
     <TextBlock Text="GPU: индекс 0. Проверить устройства можно командой video2x --list-devices." Foreground="#97ABC8" Margin="0,8,0,0"/>
    </StackPanel>
   </Expander>
  </StackPanel>
  <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>
  <StackPanel Grid.Row="3">
   <TextBlock x:Name="StatusText" Text="Готов к работе" Margin="0,0,0,8"/>
   <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Margin="0,0,0,16" Foreground="#76B2FF"/>
   <StackPanel Orientation="Horizontal"><Button x:Name="RunButton" Content="Обработать фрагмент" Click="Run"/><Button x:Name="CancelButton" Content="Отмена" IsEnabled="False" Click="Cancel"/><Button Content="Открыть результаты" Click="OpenResults"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
