<!-- Ресурсы и запуск приложения. -->
<Application x:Class="FrameForge.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#D5E5FF"/><Setter Property="Foreground" Value="#132039"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Background" Value="#1F2A3E"/><Setter Property="Foreground" Value="#F1F5FF"/><Setter Property="BorderBrush" Value="#40516D"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#132039"/></Style>
 </Application.Resources>
</Application>
